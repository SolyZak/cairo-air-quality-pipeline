# ---------------------------------------------------------------------------
# Copy this file to .env and adjust. .env is gitignored; this example is not.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
# One Postgres 16 container hosts TWO databases:
#   ${POSTGRES_DB}  -> the warehouse (raw / staging / analytics schemas)
#   ${AIRFLOW_DB}   -> Airflow's own metadata database (added in stage 3)
# They share a superuser because this is a local single-developer setup.
# In production these would be separate instances with separate least-privilege
# roles; see README "Design decisions".
POSTGRES_USER=airquality
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=airquality
AIRFLOW_DB=airflow

# Hostname of the database AS SEEN BY THE CODE THAT CONNECTS TO IT.
#   postgres   -> from inside the compose network (the ingest and Airflow containers)
#   localhost  -> from a virtualenv running directly on your Mac
# The compose file overrides this to `postgres` for its own services, so the
# value here only matters if you run the CLI outside Docker.
POSTGRES_HOST=postgres

# Host port to publish Postgres on. Change if 5432 is already taken locally.
POSTGRES_HOST_PORT=5432

# --- Ingestion target (used from stage 2 onwards) -------------------------
# Cairo, Egypt. Open-Meteo needs no API key, so there is no secret here --
# but the file is still gitignored so the habit holds when one appears.
AQ_LOCATION_CODE=cairo
AQ_LATITUDE=30.0444
AQ_LONGITUDE=31.2357

# How many days of hourly history each scheduled run pulls.
AQ_LOOKBACK_DAYS=7

# Open-Meteo Air Quality API base URL.
AQ_API_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# --- Airflow ---------------------------------------------------------------
# Generate real values with ./scripts/gen_secrets.sh -- it writes them straight
# into .env, which is gitignored. Never commit filled-in values.
#
# FERNET_KEY encrypts connection passwords and Variables at rest in Airflow's
# metadata database. Changing it later makes existing encrypted values
# unreadable, so generate it once per environment and keep it.
AIRFLOW_FERNET_KEY=
# Signs the JWTs a running task uses to call back into the API server.
AIRFLOW_JWT_SECRET=

# Login for the web UI at http://localhost:8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_WEB_PORT=8080

# Port for the dbt documentation site (./scripts/dbt_docs.sh)
DBT_DOCS_PORT=8081
